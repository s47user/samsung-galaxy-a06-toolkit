# ==============================================================================
# Samsung Galaxy A06 (SM-A065F) / MediaTek Helio G85 Kernel Optimization Matrix
# Recommended configuration based on Physwizz & Community Research (Android 14)
# ==============================================================================

# --- Strip Samsung Overhead & Kernel Anti-Tamper ---
# Disables DEFEX process killer (prevents killing root daemons and unauthorized syscalls)
# CONFIG_SECURITY_DEFEX is not set
# CONFIG_SECURITY_DSMS is not set
# CONFIG_TIMA is not set
# CONFIG_KNOX_KAP is not set
# CONFIG_PROCA is not set

# --- APatch / KernelPatch Dynamic Hooking Support ---
# Required for KernelPatch Modules (KPM) and runtime symbol tracing
CONFIG_KPROBES=y
CONFIG_HAVE_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_BPF_SYSCALL=y

# --- Fast In-RAM zRAM Compression (Eliminating eMMC 5.1 Bottleneck) ---
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
# Alternative high-compression option:
# CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_WRITEBACK=n
CONFIG_ZSMALLOC=y

# --- CPU Scheduling & EAS Fluidity ---
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# Set up_rate_limit_us to 500 in sysfs to ramp Cortex-A75 cores instantly on touch

# --- Storage & Filesystem ---
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# --- Networking & WireGuard ---
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_WIREGUARD=y

# --- Battery & Wakelock Management ---
# Blocks Samsung telemetry wakeups during deep sleep
# CONFIG_BOEFFLA_WL_BLOCKER=y
